{
  "name": "new-summary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rm -rf .next",
    "clean:all": "rm -rf .next node_modules pnpm-lock.yaml",
    "clean:cache": "pnpm store prune && pnpm cache clean --force",
    "fresh": "pnpm run clean:all && pnpm install && pnpm run dev",
    "dev:clean": "pnpm run clean && pnpm run dev",
    "dev:port": "next dev -p 3001",
    "kill:port": "lsof -ti:3000 | xargs kill -9 || true"
  },
